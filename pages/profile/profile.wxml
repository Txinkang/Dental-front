<!--pages/profile/profile.wxml-->
<view class="container">
  <view class="profile-header">
    <!-- <view class="avatar">
      <text class="avatar-placeholder">{{adminInfo.adminAccount ? adminInfo.adminAccount.substring(0, 1).toUpperCase() : 'A'}}</text>
    </view> -->
    <view class="profile-name">{{adminInfo.adminAccount || '管理员'}}</view>
  </view>

  <view class="info-section">
    <view class="section-title">个人信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">账号ID：</text>
        <text class="info-value">{{adminInfo.adminId || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">账号名称：</text>
        <text class="info-value">{{adminInfo.adminAccount || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">创建时间：</text>
        <text class="info-value">{{adminInfo.createdAt || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">更新时间：</text>
        <text class="info-value">{{adminInfo.updatedAt || '--'}}</text>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view> 