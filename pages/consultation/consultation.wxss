/* pages/consultation/consultation.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.refresh-btn {
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  background-color: #f0f0f0;
}

/* 咨询卡片样式 */
.consultation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.consultation-card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.consultation-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  font-size: 28rpx;
}

.info-label {
  width: 150rpx;
  color: #666;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 问题区域 */
.question-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.question-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.question-content {
  font-size: 30rpx;
  color: #333;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* 回复区域 */
.answer-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.answer-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.answer-content {
  font-size: 30rpx;
  color: #07c160;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  word-break: break-all;
}

.answer-input-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.answer-input-area textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.reply-btn {
  align-self: flex-end;
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  background-color: #07c160;
  color: #fff;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}