/* pages/education/education.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索区域样式 */
.header {
    background-color: #fff;
    padding: 20rpx;
    border-radius: 10rpx;
    margin-bottom: 20rpx;
  }
  
  .header-top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }
  
  .search-bar {
    width: 60%;
  }
  
  .search-bar input {
    width: 100%;
    height: 70rpx;
    padding: 0 20rpx;
    border: 2rpx solid #ddd;
    border-radius: 8rpx;
  }
  
  .button-group {
    width: 35%;
    display: flex;
    justify-content: flex-end;
    gap: 10rpx;
  }
  
  .btn {
    padding: 0 30rpx;
    min-width: 120rpx;
    height: 70rpx;
    line-height: 70rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    background-color: #f0f0f0;
  }
  
  .btn-primary {
    background-color: #07c160;
    color: #fff;
  }
  
  .profile-btn {
    padding: 0 20rpx;
    min-width: 80rpx;
    height: 70rpx;
    line-height: 70rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    background-color: #f8f8f8;
    color: #666;
    margin-left: 10rpx;
  }

/* 科普卡片样式 */
.education-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.education-card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.education-content {
  margin-bottom: 20rpx;
}

.education-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.education-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.education-time {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #999;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-btn {
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  border-radius: 6rpx;
  background-color: #f0f0f0;
}

.action-btn.delete {
  background-color: #ff4d4f;
  color: #fff;
}

/* 分页样式 */
.pagination {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}

.page-info {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.page-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.page-btn {
  min-width: 160rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
}

.page-btn[disabled] {
  background-color: #f5f5f5;
  color: #999;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.form-item input, .form-item textarea {
  width: 100%;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-item input {
  height: 80rpx;
  padding: 0 20rpx;
}

.form-item textarea {
  height: 240rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 32rpx;
  background-color: #fff;
  border-radius: 0;
}

.modal-btn.confirm {
  background-color: #07c160;
  color: #fff;
}