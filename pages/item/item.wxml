<!--pages/item/item.wxml-->
<view class="container">
  <view class="header">
    <view class="header-top">
      <view class="search-bar">
        <input type="text" placeholder="搜索项目" bindinput="handleSearch" value="{{searchValue}}" />
      </view>
      <view class="button-group">
        <button class="btn" bindtap="handleRefresh">刷新</button>
        <button class="btn btn-primary" bindtap="showAddModal">添加</button>
      </view>
    </view>
  </view>

  <view class="card" wx:for="{{items}}" wx:key="itemId">
    <view class="card-content">
      <view class="item-name">{{item.itemName}}</view>
      <view class="doctor-list">
        <text class="doctor-title">医生管理：</text>
        <view class="doctor-tags">
          <view class="doctor-tag" wx:for="{{item.doctor}}" wx:for-item="doctor" wx:key="doctorId">
            {{doctor.doctorName}}
            <text class="delete-doctor" catchtap="handleDeleteDoctor" data-item-id="{{item.itemId}}" data-doctor-id="{{doctor.doctorId}}">×</text>
          </view>
        </view>
      </view>
    </view>
    <view class="card-actions">
      <button class="action-btn" bindtap="showEditModal" data-item="{{item}}">修改</button>
      <button class="action-btn delete" bindtap="handleDelete" data-item-id="{{item.itemId}}">删除</button>
    </view>
  </view>

  <!-- 分页 -->
  <view class="pagination" wx:if="{{total > 0}}">
    <view class="page-info">
      共 {{total}} 条记录，当前第 {{currentPage}} 页
    </view>
    <view class="page-buttons">
      <button class="page-btn" disabled="{{page_num <= 1}}" bindtap="handlePrevPage">上一页</button>
      <button class="page-btn" disabled="{{page_num * page_size >= total}}" bindtap="handleNextPage">下一页</button>
    </view>
  </view>

  <!-- 添加/修改弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="hideModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text>{{isEdit ? '修改项目' : '添加项目'}}</text>
      </view>
      <view class="modal-body">
        <input type="text" placeholder="请输入项目名称" value="{{modalData.itemName}}" bindinput="handleItemNameInput"/>
        <view class="doctor-select">
          <view class="doctor-select-title">选择医生：</view>
          <checkbox-group bindchange="handleDoctorSelect">
            <label class="doctor-checkbox" wx:for="{{doctors}}" wx:key="doctorId">
              <checkbox value="{{item.doctorId}}" checked="{{item.checked}}"/>
              <text>{{item.doctorName}}</text>
            </label>
          </checkbox-group>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn" bindtap="hideModal">取消</button>
        <button class="modal-btn confirm" bindtap="handleConfirm">确定</button>
      </view>
    </view>
  </view>
</view>