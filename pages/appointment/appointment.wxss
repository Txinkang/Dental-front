/* pages/appointment/appointment.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.refresh-section {
  margin-bottom: 20rpx;
}

.refresh-btn {
  background-color: #4CAF50;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

.item-list {
  width: 100%;
}

.item-card {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.select-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.select-label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
}

.picker {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.appoint-btn {
  width: 100%;
  margin-top: 20rpx;
  background-color: #1989fa;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 8rpx;
}

.appoint-btn:active {
  opacity: 0.8;
}