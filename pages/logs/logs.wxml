<!--pages/logs/logs.wxml-->
<view class="login-container">
  <view class="login-box">
    <view class="login-title">{{isRegister ? '用户注册' : '用户登录'}}</view>
    <view class="input-group">
      <input 
        type="text" 
        placeholder="请输入账号" 
        bindinput="inputAccount"
        value="{{userAccount}}"
      />
    </view>
    <view class="input-group">
      <input 
        type="password" 
        placeholder="请输入密码" 
        bindinput="inputPassword"
        value="{{userPassword}}"
      />
    </view>
    <!-- 注册时显示的额外字段 -->
    <block wx:if="{{isRegister}}">
      <view class="input-group">
        <input 
          type="text" 
          placeholder="请输入用户名" 
          bindinput="inputUserName"
          value="{{userName}}"
        />
      </view>
      <view class="input-group">
        <input 
          type="text" 
          placeholder="请输入邮箱" 
          bindinput="inputEmail"
          value="{{userEmail}}"
        />
      </view>
    </block>
    <button class="login-btn" bindtap="{{isRegister ? 'handleRegister' : 'handleLogin'}}">
      {{isRegister ? '注册' : '登录'}}
    </button>
    <view class="switch-form" bindtap="switchForm">
      {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
    </view>
  </view>
</view>
